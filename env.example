# ============================================================================
#  NEBRAS | نبراس — متغيرات البيئة المطلوبة
#  انسخ هذا الملف إلى `.env` للتطوير المحلي، واضبط نفس القيم في Vercel:
#  Project → Settings → Environment Variables (Production + Preview)
# ============================================================================

# --- قاعدة البيانات (الأول يُستخدم، والباقي بدائل مدعومة) -------------------
# من Supabase: Dashboard → Project Settings → Database → Connection string (URI)
# استخدم رابط IPv4 أو الـ Session Pooler (المنفذ 5432) وليس Transaction Pooler.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# بديل 1: الاسم الذي يستخدمه تكامل Supabase مع Vercel
# SUPABASE_DB_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# بديل 2: متغيرات منفصلة (تُجمع تلقائيًا في رابط اتصال مع sslmode=require)
# PGHOST="aws-0-eu-central-1.pooler.supabase.com"
# PGPORT="5432"
# PGUSER="postgres.[ref]"
# PGPASSWORD="********"
# PGDATABASE="postgres"

# --- أمان الجلسات -----------------------------------------------------------
# سرّ توقيع رمز الجلسة (غيّره في الإنتاج إلى قيمة عشوائية طويلة).
# توليد قيمة: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# --- اختياري ----------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL="https://nebras.vercel.app"

# ============================================================================
#  ملاحظات مهمة
#  1) لا حاجة لتشغيل `drizzle-kit push` على Supabase: تنشئ المنصة جداولها
#     تلقائيًا في أول طلب خادم (src/db/migrate.ts) ثم تبذر البيانات الأولية
#     (src/db/seed.ts) مرة واحدة فقط.
#  2) إن رغبت بتهيئة المخطط يدويًا بدلًا من التهيئة التلقائية:
#     DATABASE_URL="..." npx drizzle-kit push --config drizzle.config.json
#     (حدّث رابط الاتصال داخل drizzle.config.json أو مرّره عبر المتغير).
#  3) حسابات تجريبية بعد البذر:
#     admin@nebras.app  / Admin@12345   (مدير المنصة)
#     student@nebras.app / Student@12345 (طالب)
# ============================================================================
